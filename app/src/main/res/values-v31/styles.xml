<resources>
    <style name="Theme.Mynichi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/mynichi_raspberry</item>
        <item name="android:windowBackground">@color/mynichi_pale_pink</item>
        <item name="android:navigationBarColor">@color/mynichi_pale_pink</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/mynichi_pale_pink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/mynichi_raspberry</item>
    </style>
</resources>
